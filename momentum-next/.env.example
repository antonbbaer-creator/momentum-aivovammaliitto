# --- Google Drive (olemassaoleva) ---
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# --- Firebase Cloud Messaging (Web Push) ---
# Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates -> Generate key pair
NEXT_PUBLIC_FCM_VAPID_KEY=

# --- Google Calendar (uusi: Cloud Console → OAuth client ID, Web application) ---
# Redirect URI: ${OAUTH_REDIRECT_BASE_URL}/api/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Microsoft Calendar (uusi: Azure Portal → App registrations) ---
# Redirect URI: ${OAUTH_REDIRECT_BASE_URL}/api/oauth/microsoft/callback
# Permissions: Calendars.ReadWrite + offline_access
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- OAuth pohja-URL ---
# Lokaalisti: http://localhost:3000
# Tuotannossa: https://your-domain.example
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# --- OAuth state HMAC -avain ---
# Allekirjoittaa OAuth-state-tokenin (CSRF-suoja). Pakollinen — minimi 32 merkkiä.
# Generoi turvallinen arvo: openssl rand -base64 48
OAUTH_STATE_SECRET=

# --- Firebase Admin (server-side Firestore-kirjoitus OAuth-callbackeille ja API-routeille) ---
# Joko base64-pakattu service account JSON tai puhdas JSON
# Service account: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_ADMIN_KEY=
