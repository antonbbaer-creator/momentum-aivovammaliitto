rules_version = '2';

// Momentum — Firebase Storage -säännöt.
// Äänitteet (ja muut työtilan tiedostot) tallennetaan polkuun
// organizations/{orgId}/... — kirjautunut käyttäjä voi lukea ja kirjoittaa.
// Deploy: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    match /organizations/{orgId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
