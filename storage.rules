rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Organisaation tiedostot: vain saman orgin jäsenet pääsevät käsiksi.
    // Kanoninen jäsenyys luetaan organizations/{orgId}/members/{uid} -dokkarista
    // (sama lähde kuin firestore.rulesissa). Käyttäjä ei voi väärentää tätä
    // omalla userOrgs-dokumentillaan.
    match /organizations/{orgId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    // Kaikki muu estetty
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
